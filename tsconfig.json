{
    "compilerOptions": {
        "target": "ES2020",
        "lib": ["ES2020"],
        "module": "commonjs",
        "moduleResolution": "node",
        "outDir": "dist/cjs",
        "rootDir": "src",
        "declaration": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "strict": false,
        "noImplicitAny": false,
        "types": ["node"]
    },
    "include": ["src/**/*.ts"]
}
